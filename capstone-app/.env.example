# Environment configuration for capstone-app.
# Copy to `.env.local` and fill values for local development.
# Nothing in this file is secret — it only documents the variable names used
# by the app so contributors know what to provide.

# --- Browser-safe: prefixed NEXT_PUBLIC_, inlined at build time ---
# Absolute base URL used by the /health server component to fetch /api/health.
# Keep http://localhost:3000 for local dev; set it to the deployed origin later.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Display name + version shown in the UI (footer and health page).
NEXT_PUBLIC_APP_NAME=Capstone App
NEXT_PUBLIC_APP_VERSION=0.1.0

# --- Server-only: NEVER exposed to the browser ---
# Public URL the server pings from /api/health to prove outbound connectivity.
HEALTH_CHECK_URL=https://api.github.com/repos/omar320250068-prog/capstone-ai-track

# Expected HTTP status for a healthy ping (defaults to 200).
EXPECTED_HEALTH_STATUS=200